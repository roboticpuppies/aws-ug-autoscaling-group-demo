# Terraform
# .terraform.lock.hcl is deliberately NOT ignored: it records the provider
# version this config was validated against, so a fresh clone resolves the same
# one instead of whatever 6.x ships next.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
tfplan
*.tfplan

# Packer
packer_cache/
*.box
manifest.json

# Key material — never commit. See docs/superpowers/specs §13.
*.pem
*.ppk
*.key
id_rsa*
id_ed25519*
*.p12
*.pfx

# Local
.DS_Store
*.log
